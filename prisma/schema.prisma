generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  feedbacks Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  role         String    @default("VIEWER") // Using String to represent Role enum for SQLite compatibility if needed, or keeping standard. SQLite supports enums via Prisma but let's keep it safe.

  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  reports      Report[]
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?

  sentiment      String?         // SQLite compatibility
  sentimentScore Float?
  
  status         String          @default("NEW")

  createdAt      DateTime        @default(now())

  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  themes         FeedbackTheme[]
  embedding      Embedding?
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String?

  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbacks   FeedbackTheme[]
}

model FeedbackTheme {
  feedbackId  String
  themeId     String
  confidence  Float?

  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme       Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
}

model Embedding {
  id          String   @id @default(cuid())
  feedbackId  String   @unique
  vector      String   // Stored as JSON stringified array [0.1, 0.2, ...] for SQLite/universal support

  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id           String    @id @default(cuid())
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  contentJson  String
  createdAt    DateTime  @default(now())

  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  generatedById String
  generatedBy   User      @relation(fields: [generatedById], references: [id], onDelete: Cascade)
}
